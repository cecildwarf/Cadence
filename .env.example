# Optional overrides only — you do not need this file to run Cadence.
# Copy it to .env only if you want to change a default below.
# With no .env at all, Cadence starts with working defaults and the
# first-run wizard in the web UI asks for your folders.
#
# MEDIA_ROOT — the ONE folder to set. It is the host folder that
# holds all your media, mounted into the container at /disks.
# On the example server it is /disks; elsewhere it might be
# /media, /data, or a NAS mount point. Every inbox/output/
# Processed/Review folder you pick in the web UI must be under
# this folder (inside the container: under /disks).
#
# A running container cannot gain a new host folder — mounts are
# fixed when the container starts. So: pick a MEDIA_ROOT that
# contains everything Cadence will ever need (inbox + Plex
# library). Changing folders *inside* it later needs no restart:
# just pick the new folder in Settings. Changing MEDIA_ROOT
# itself needs `docker compose up -d` to recreate the container.
MEDIA_ROOT=/disks
#
# INBOX_DIR  = where messy multi-file audiobook folders land (input).
#              One folder per book, under /disks.
#              Example: /disks/Audiobooks/Inbox
# OUTPUT_DIR = your Plex audiobook library folder (output). The finished
#              .m4b files are placed here as Author/Book/Book.m4b.
#              Example: /disks/Audiobooks
# Leave both unset to be asked on first open.
# INBOX_DIR=/disks/Audiobooks/Inbox
# OUTPUT_DIR=/disks/Audiobooks
# PROCESSED_DIR — where finished books' originals are kept.
# Leave unset for the default: a Processed folder inside the inbox.
# PROCESSED_DIR=/disks/Audiobooks/Processed
# REVIEW_DIR — where health-held files wait for your decision.
# Leave unset for the default: a Review folder inside the inbox.
# Must stay outside the Plex output folder.
# REVIEW_DIR=/disks/Audiobooks/Review
#
# Port Cadence listens on (default 8285). Change it if 8285 is
# already in use on your server — see README "Will it clash?".
# PORT=8285
# Timezone for log timestamps (e.g. UTC, America/New_York, Europe/London).
TZ=UTC
# User/group the container runs as (match your media server's user).
PUID=1000
PGID=1000
TEMP_DIR=/app/data/temp
AAC_BITRATE=96k
AUDNEXUS_URL=https://api.audnexus.com
# keep | processed — default processed (originals moved to
# Processed/<Author>/<Book>/ after a successful build). Originals
# are never deleted automatically at build time.
KEEP_ORIGINALS=processed
#
# Server-busy backoff — all optional, all editable in Settings
# instead. On by default: builds wait/pause when the server load
# tops LOAD_THRESHOLD_PCT % of its CPU cores, or Plex starts
# transcoding (needs PLEX_URL + PLEX_TOKEN). Quiet for
# QUIET_GRACE_SECONDS before a paused build resumes. RUN_START /
# RUN_END (HH:MM) is the backup schedule — empty means any time.
# BACKOFF_ENABLED=1
# LOAD_THRESHOLD_PCT=70
# QUIET_GRACE_SECONDS=120
# BACKOFF_CHECK_SECONDS=30
# PLEX_URL=http://<server-ip>:32400
# PLEX_TOKEN=
# RUN_START=
# RUN_END=
